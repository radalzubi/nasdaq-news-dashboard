# ============================================================================
# Nasdaq News Dashboard — environment configuration
# Copy this file to `.env.local` and fill in the keys you have.
# The app runs WITHOUT any keys in clearly-labeled DEMO mode (sample data,
# never presented as live). Add keys to switch features to live/delayed data.
# ============================================================================

NEXT_PUBLIC_APP_NAME=Nasdaq News Dashboard

# Private-link password. Set this (e.g. in Vercel env vars) to require a login
# on the deployed site — keeps your link private. Leave empty for no gate (local).
# To open the site: enter any username + this password in the browser prompt.
SITE_PASSWORD=

# Default timezone used for market clock + macro event times.
NEXT_PUBLIC_TIMEZONE=America/New_York

# --- Market data + news providers (server-side only, never exposed) ---------

# Finnhub — quotes, company news, earnings calendar, market news.
# Free tier available at https://finnhub.io  (recommended first key to add)
FINNHUB_API_KEY=

# Alpha Vantage — quotes + intraday bars fallback, news sentiment.
# Free tier at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Alpaca — live/delayed market data + bars (optional, higher quality quotes).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Polygon — market data + news (optional).
POLYGON_API_KEY=

# Nasdaq Data Link — exchange/market datasets (optional).
NASDAQ_DATA_LINK_API_KEY=

# FRED — macro series (10Y yield, etc.). Free key at
# https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Trading Economics — economic calendar (optional).
TRADING_ECONOMICS_KEY=
TRADING_ECONOMICS_SECRET=

# --- Provider selection (optional overrides) --------------------------------
# Comma-separated priority order. The first provider that has a key + supports
# the capability wins; "demo" is always the final fallback.
#   quotes:      finnhub,alphaVantage,demo
#   news:        finnhub,alphaVantage,demo
#   macro:       fred,demo
PROVIDER_ORDER_QUOTES=finnhub,alphaVantage,demo
PROVIDER_ORDER_NEWS=finnhub,alphaVantage,demo
PROVIDER_ORDER_MACRO=fred,demo

# --- Persistence (optional) -------------------------------------------------
# Watchlist / alerts / journal fall back to in-memory + localStorage when unset.
DATABASE_URL=
REDIS_URL=
